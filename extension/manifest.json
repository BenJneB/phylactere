{
  "manifest_version": 3,
  "name": "Phylactère",
  "version": "2.0.0",
  "description": "Traduit en temps réel les bulles des webtoons de comic.naver.com, avec un serveur local (OCR et LLM sur votre PC).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://comic.naver.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["defaults.js", "api.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://comic.naver.com/*"],
      "js": ["defaults.js", "naver.js", "render.js", "bubbles.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Phylactère"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "phylactere@local",
      "strict_min_version": "121.0"
    }
  }
}
